<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.quiz.PlayQuizFragment">

    <!-- Container de chargement -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loadingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/loadingProgressBar"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.45" />

        <TextView
            android:id="@+id/textLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Chargement du quiz..."
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/loadingProgressBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Container du contenu du quiz avec ScrollView -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/quizContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Titre du Quiz -->
        <TextView
            android:id="@+id/textQuizTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Titre du Quiz"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textAlignment="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Mode de jeu -->
        <TextView
            android:id="@+id/textGameMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mode: Standard"
            android:textSize="14sp"
            android:textStyle="italic"
            android:textColor="#3F51B5"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/textQuizTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Progression -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/textGameMode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Question 1/10"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/progressBar"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Score -->
        <TextView
            android:id="@+id/textScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score: 0"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/progressBar"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Timer -->
        <TextView
            android:id="@+id/textTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Temps: 60s"
            android:textSize="16sp"
            android:textColor="#F44336"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/progressBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ScrollView pour le contenu défilable -->
        <ScrollView
            android:id="@+id/scrollViewContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/textProgress"
            app:layout_constraintBottom_toTopOf="@id/buttonValidate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Texte de la question -->
                <TextView
                    android:id="@+id/textQuestionPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Texte de la question..."
                    android:textSize="18sp" />

                <!-- Image de la question (si présente) -->
                <ImageView
                    android:id="@+id/imageQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Image de la question"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <!-- Container pour les options -->
                <RadioGroup
                    android:id="@+id/radioGroupOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <RadioButton
                        android:id="@+id/radioOption1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Option 1"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:paddingLeft="24dp"
                        android:paddingRight="12dp"
                        android:button="@null"
                        android:background="@drawable/option_background" />

                    <RadioButton
                        android:id="@+id/radioOption2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Option 2"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:paddingLeft="24dp"
                        android:paddingRight="12dp"
                        android:button="@null"
                        android:background="@drawable/option_background" />

                    <RadioButton
                        android:id="@+id/radioOption3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Option 3"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:paddingLeft="24dp"
                        android:paddingRight="12dp"
                        android:button="@null"
                        android:background="@drawable/option_background" />

                    <RadioButton
                        android:id="@+id/radioOption4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 4"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:paddingLeft="24dp"
                        android:paddingRight="12dp"
                        android:button="@null"
                        android:background="@drawable/option_background" />

                </RadioGroup>

                <!-- Explication (visible après avoir répondu) -->
                <TextView
                    android:id="@+id/textExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:padding="12dp"
                    android:text="Explication de la réponse..."
                    android:textSize="14sp"
                    android:background="#E8F5E9"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

        <!-- Boutons d'action -->
        <Button
            android:id="@+id/buttonNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Suivant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/buttonValidate"
            app:layout_constraintWidth_percent="0.48" />

        <Button
            android:id="@+id/buttonValidate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Valider"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/buttonNext"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.48" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout> 